{
  "TCP": {
    "443": { "HTTPS": true },
    "8443": { "HTTPS": true },
    "9000": { "TCPForward": "clickhouse:9000" }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": { "/": { "Proxy": "http://127.0.0.1:8317" } }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": { "/": { "Proxy": "http://clickhouse:8123" } }
    }
  }
}
