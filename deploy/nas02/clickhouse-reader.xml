<clickhouse>
    <users>
        <reader>
            <password from_env="CLICKHOUSE_READER_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON cliproxy.*</query>
            </grants>
        </reader>
    </users>
</clickhouse>
